{
  "name": "Lyrics",
  "author": "Jorge Pardo",
  "version": "6.1.3",
  "description": "Fetch lyrics from multiple sources",
  "website": "https://github.com/J0R6IT0/navidrome-lyrics-plugin",

  "permissions": {
    "http": {
      "reason": "To fetch lyrics from the internet. All hosts required for custom URLs.",
      "requiredHosts": ["*"]
    },
    "library": {
      "reason": "To save lyrics as .lrc files.",
      "filesystem": true
    },
    "cache": {
      "reason": "To cache lyrics."
    }
  },

  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "lyricsFormats": {
          "type": "string",
          "title": "Lyrics formats",
          "default": "ttml,lyricsfile,elrc,lrc,srt,plain",
          "description": "Comma-separated list of formats to fetch, ordered by priority. Remove a format to disable it (not recommended unless you have a specific use case). Valid values: lrc, elrc, ttml, srt, lyricsfile, plain."
        },

        "instrumentalText": {
          "type": "string",
          "title": "Instrumental lyrics text",
          "default": "Instrumental",
          "description": "The text to use for instrumental lyrics."
        },

        "stripSectionLabels": {
          "type": "boolean",
          "title": "Strip section labels ([Verse], [Chorus], etc.)",
          "default": false
        },

        "providersList": {
          "type": "array",
          "title": "Lyrics providers",
          "default": [{ "provider": "lrclib" }, { "provider": "lyrics.ovh" }],
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "title": "Provider",
                "default": "lrclib",
                "oneOf": [
                  { "const": "lrclib", "title": "LRCLIB" },
                  { "const": "lyrics.ovh", "title": "lyrics.ovh" },
                  { "const": "kugou", "title": "KuGou" },
                  { "const": "netease", "title": "NetEase" },
                  { "const": "qqmusic", "title": "QQ Music" },
                  { "const": "applemusic", "title": "Apple Music" }
                ]
              },
              "baseUrl": {
                "type": "string",
                "title": "Custom base URL",
                "description": "Optional. Leave empty to use the provider's default."
              },
              "mediaUserToken": {
                "type": "string",
                "title": "Media user token",
                "description": "The media-user-token of an Apple Music subscriber, required to access lyrics."
              },
              "storefront": {
                "type": "string",
                "title": "Storefront",
                "description": "Optional. Storefront code (e.g. us, gb, es). Auto-detected from the account when left empty. Only include it if the auto-detection is not working correctly."
              }
            },
            "required": ["provider"],
            "allOf": [
              {
                "if": {
                  "properties": { "provider": { "const": "applemusic" } },
                  "required": ["provider"]
                },
                "then": { "required": ["mediaUserToken"] }
              }
            ]
          }
        },

        "enableCache": {
          "type": "boolean",
          "title": "Enable lyrics cache",
          "default": true
        },

        "cacheTtlHours": {
          "type": "integer",
          "title": "Cache TTL (hours)",
          "minimum": 1,
          "default": 168,
          "description": "How long cached lyrics remain valid. Default is 7 days."
        },

        "negativeCache": {
          "type": "boolean",
          "title": "Cache negative results (i.e. no lyrics found)",
          "default": true
        },

        "negativeCacheTtlHours": {
          "type": "integer",
          "title": "Negative cache TTL (hours)",
          "minimum": 1,
          "default": 24,
          "description": "How long negative cache entries remain valid. Default is 24 hours."
        },

        "writeLyrics": {
          "type": "boolean",
          "title": "Write lyrics to files",
          "default": false
        },

        "plainExtension": {
          "type": "string",
          "title": "Plain lyrics extension",
          "default": "txt",
          "description": "File extension for plain lyrics files. LRC, ELRC, TTML, SRT and YAML files always use their standard extension."
        },

        "instrumentalExtension": {
          "type": "string",
          "title": "Instrumental lyrics extension",
          "default": "txt",
          "description": "File extension for instrumental lyrics files."
        },

        "overwriteLyrics": {
          "type": "boolean",
          "title": "Overwrite existing lyrics files",
          "default": false
        },

        "writeToSpecificFolder": {
          "type": "boolean",
          "title": "Write lyrics to a custom path instead of next to each song file.",
          "default": false
        },

        "writeToSpecificFolderLibraryId": {
          "type": "integer",
          "title": "Library ID",
          "minimum": 0,
          "description": "The library whose root will be used as the base for the output path. Use the numeric ID as shown in Navidrome."
        },

        "writeToSpecificFolderTemplate": {
          "type": "string",
          "title": "Output path template",
          "default": "_lyrics/{type}/{track:album_artist} - {track:album}/{track:disc_number:2} - {track:track_number:2} {track:title}",
          "description": "Path relative to the selected library root. Supports template variables. See GitHub for the full list."
        }
      },
      "if": {
        "properties": {
          "writeToSpecificFolder": { "const": true }
        },
        "required": ["writeToSpecificFolder"]
      },
      "then": {
        "required": ["writeToSpecificFolderLibraryId"]
      }
    },

    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Lyrics",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/lyricsFormats"
            },
            {
              "type": "Control",
              "scope": "#/properties/instrumentalText"
            },
            {
              "type": "Control",
              "scope": "#/properties/stripSectionLabels"
            }
          ]
        },

        {
          "type": "Group",
          "label": "Providers",
          "elements": [
            {
              "type": "Label",
              "text": "The list of providers to query, ordered by priority. The same provider can be included multiple times with different parameters (for example, lrclib with a custom base URL and with the default)."
            },
            {
              "type": "Control",
              "scope": "#/properties/providersList",
              "options": {
                "showSortButtons": true,
                "elementLabelProp": "provider",
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/provider"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/baseUrl",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "enum": ["lrclib", "lyrics.ovh"]
                          }
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/mediaUserToken",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "applemusic"
                          }
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/storefront",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "applemusic"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },

        {
          "type": "Group",
          "label": "Cache",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/enableCache"
            },
            {
              "type": "Control",
              "scope": "#/properties/cacheTtlHours",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/enableCache",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/negativeCache",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/enableCache",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/negativeCacheTtlHours",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "negativeCache": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "negativeCache"]
                  }
                }
              }
            }
          ]
        },

        {
          "type": "Group",
          "label": "File Writing",
          "elements": [
            {
              "type": "Label",
              "text": "NOTE: Your music library must be mounted with write access and the plugin must have permission to write files."
            },
            {
              "type": "Control",
              "scope": "#/properties/writeLyrics"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/plainExtension"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/instrumentalExtension"
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/writeLyrics",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/overwriteLyrics",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/writeLyrics",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/writeToSpecificFolder",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/writeLyrics",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/writeToSpecificFolderLibraryId",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "writeLyrics": {
                        "const": true
                      },
                      "writeToSpecificFolder": {
                        "const": true
                      }
                    },
                    "required": ["writeLyrics", "writeToSpecificFolder"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/writeToSpecificFolderTemplate",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "writeLyrics": {
                        "const": true
                      },
                      "writeToSpecificFolder": {
                        "const": true
                      }
                    },
                    "required": ["writeLyrics", "writeToSpecificFolder"]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
