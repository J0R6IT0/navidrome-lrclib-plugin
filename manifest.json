{
  "name": "Lyrics",
  "author": "Jorge Pardo",
  "version": "6.1.0",
  "description": "Fetch lyrics from multiple sources",
  "website": "https://github.com/J0R6IT0/navidrome-lyrics-plugin",

  "permissions": {
    "http": {
      "reason": "To fetch lyrics from the internet. All hosts required for custom URLs.",
      "requiredHosts": ["*"]
    },
    "library": {
      "reason": "To save lyrics as .lrc files.",
      "filesystem": true
    },
    "cache": {
      "reason": "To cache lyrics."
    }
  },

  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "lyricsSynced": {
          "type": "boolean",
          "title": "Synced lyrics",
          "default": true,
          "description": "Fetch time-synced lyrics."
        },

        "lyricsPlain": {
          "type": "boolean",
          "title": "Plain lyrics",
          "default": true,
          "description": "Fetch plain (non-synced) lyrics."
        },

        "lyricsPriority": {
          "type": "string",
          "title": "Priority",
          "description": "When both types are available, which one to return first.",
          "default": "synced",
          "oneOf": [
            {
              "const": "synced",
              "title": "Prefer synced"
            },
            {
              "const": "plain",
              "title": "Prefer plain"
            }
          ]
        },

        "instrumentalText": {
          "type": "string",
          "title": "Instrumental lyrics text",
          "default": "Instrumental",
          "description": "The text to use for instrumental lyrics."
        },

        "stripSectionLabels": {
          "type": "boolean",
          "title": "Strip section labels ([Verse], [Chorus], etc.)",
          "default": false
        },

        "providers": {
          "type": "string",
          "title": "Lyrics providers",
          "default": "lrclib,lyrics.ovh",
          "description": "Comma-separated list of providers to use, ordered by priority. See the GitHub page for available providers."
        },

        "enableCache": {
          "type": "boolean",
          "title": "Enable lyrics cache",
          "default": true
        },

        "cacheTtlHours": {
          "type": "integer",
          "title": "Cache TTL (hours)",
          "minimum": 1,
          "default": 168,
          "description": "How long cached lyrics remain valid. Default is 7 days."
        },

        "negativeCache": {
          "type": "boolean",
          "title": "Cache negative results (i.e. no lyrics found)",
          "default": true
        },

        "negativeCacheTtlHours": {
          "type": "integer",
          "title": "Negative cache TTL (hours)",
          "minimum": 1,
          "default": 24,
          "description": "How long negative cache entries remain valid. Default is 24 hours."
        },

        "writeLyrics": {
          "type": "boolean",
          "title": "Write lyrics to files",
          "default": false
        },

        "plainExtension": {
          "type": "string",
          "title": "Plain lyrics extension",
          "default": "txt",
          "description": "File extension for plain lyrics files."
        },

        "syncedExtension": {
          "type": "string",
          "title": "Synced lyrics extension",
          "default": "lrc",
          "description": "File extension for synced lyrics files."
        },

        "instrumentalExtension": {
          "type": "string",
          "title": "Instrumental lyrics extension",
          "default": "txt",
          "description": "File extension for instrumental lyrics files."
        },

        "overwriteLyrics": {
          "type": "boolean",
          "title": "Overwrite existing lyrics files",
          "default": false
        },

        "writeToSpecificFolder": {
          "type": "boolean",
          "title": "Write lyrics to a custom path instead of next to each song file.",
          "default": false
        },

        "writeToSpecificFolderLibraryId": {
          "type": "integer",
          "title": "Library ID",
          "minimum": 0,
          "description": "The library whose root will be used as the base for the output path. Use the numeric ID as shown in Navidrome."
        },

        "writeToSpecificFolderTemplate": {
          "type": "string",
          "title": "Output path template",
          "default": "_lyrics/{type}/{track:album_artist} - {track:album}/{track:disc_number:2} - {track:track_number:2} {track:title}",
          "description": "Path relative to the selected library root. Supports template variables. See GitHub for the full list."
        }
      },
      "if": {
        "properties": {
          "writeToSpecificFolder": { "const": true }
        },
        "required": ["writeToSpecificFolder"]
      },
      "then": {
        "required": ["writeToSpecificFolderLibraryId"]
      }
    },

    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Lyrics",
          "elements": [
            {
              "type": "Label",
              "text": "Select the types of lyrics to fetch."
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/lyricsSynced"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/lyricsPlain"
                }
              ]
            },
            {
              "type": "Control",
              "scope": "#/properties/lyricsPriority",
              "options": {
                "format": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "lyricsSynced": {
                        "const": true
                      },
                      "lyricsPlain": {
                        "const": true
                      }
                    },
                    "required": ["lyricsSynced", "lyricsPlain"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/instrumentalText"
            },
            {
              "type": "Control",
              "scope": "#/properties/stripSectionLabels"
            }
          ]
        },

        {
          "type": "Group",
          "label": "Providers",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/providers"
            }
          ]
        },

        {
          "type": "Group",
          "label": "Cache",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/enableCache"
            },
            {
              "type": "Control",
              "scope": "#/properties/cacheTtlHours",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/enableCache",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/negativeCache",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/enableCache",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/negativeCacheTtlHours",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "negativeCache": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "negativeCache"]
                  }
                }
              }
            }
          ]
        },

        {
          "type": "Group",
          "label": "File Writing",
          "elements": [
            {
              "type": "Label",
              "text": "NOTE: Your music library must be mounted with write access and the plugin must have permission to write files."
            },
            {
              "type": "Control",
              "scope": "#/properties/writeLyrics"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/plainExtension"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/syncedExtension"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/instrumentalExtension"
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/writeLyrics",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/overwriteLyrics",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/writeLyrics",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/writeToSpecificFolder",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/writeLyrics",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/writeToSpecificFolderLibraryId",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "writeLyrics": {
                        "const": true
                      },
                      "writeToSpecificFolder": {
                        "const": true
                      }
                    },
                    "required": ["writeLyrics", "writeToSpecificFolder"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/writeToSpecificFolderTemplate",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "writeLyrics": {
                        "const": true
                      },
                      "writeToSpecificFolder": {
                        "const": true
                      }
                    },
                    "required": ["writeLyrics", "writeToSpecificFolder"]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
